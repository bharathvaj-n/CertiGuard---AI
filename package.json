{
  "name": "fake-certificate-root",
  "version": "1.0.0",
  "description": "Root management for CertiGuard AI",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "install:all": "npm install --prefix frontend && pip install -r backend/requirements.txt",
    "backend": "cd backend && python -m app.main",
    "setup:db": "cd backend && python setup_db.py",
    "train": "cd backend && python -m app.ml.train_classifier"
  }
}
