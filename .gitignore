# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
!.env.example

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/db/
backend/app/db/

# ── ML Models (large binary files) ───────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.pth

# ── Uploads & Generated Reports ───────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# ── Dataset (local only) ──────────────────────────────────────────────────────
dataset/**/*
!dataset/**/.gitkeep

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/build/
.next/
out/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── TypeScript build artifacts ────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts
